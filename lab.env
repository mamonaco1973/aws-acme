# ==============================================================================
# lab.env — the one setting to change for your own domain
#
# The existing public Route 53 hosted zone the lab builds its names in
# (acme-lab, alb-lab and nlb-lab). apply.sh, destroy.sh and check_env.sh
# source this file; Terraform reads it as TF_VAR_zone_name in both
# 01-acme and 03-lb.
#
# ZONE_NAME set in the shell overrides the default below.
# ==============================================================================

ZONE_NAME="${ZONE_NAME:-mikes-cloud-solutions.com}"
export TF_VAR_zone_name="${ZONE_NAME}"
